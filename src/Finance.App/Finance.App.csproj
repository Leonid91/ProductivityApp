<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>ProductivityApp</AssemblyName>
    <RootNamespace>ProductivityApp.Host</RootNamespace>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Product>Productivity</Product>
    <Version>0.1.0</Version>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- Single self-contained file: nothing to install besides the WebView2 runtime that ships with Windows 10/11. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <!--
      Smaller file: the .NET libraries and the Windows API projection (used for the built-in text recognition) are trimmed
      to what the app and its libraries call; the app, the window (Windows Forms and its drawing), WebView2 (COM) and the
      other packages are kept whole, so everything they reach by reflection keeps working.
    -->
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <_SuppressWinFormsTrimError>true</_SuppressWinFormsTrimError>
    <SuppressTrimAnalysisWarnings>true</SuppressTrimAnalysisWarnings>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <CustomResourceTypesSupport>true</CustomResourceTypesSupport>
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>
  <!-- E2E=true: a published build the end-to-end check can drive (debugging port allowed), never shipped. -->
  <PropertyGroup Condition="'$(E2E)' == 'true'">
    <DefineConstants>$(DefineConstants);E2E</DefineConstants>
  </PropertyGroup>
  <PropertyGroup>
    <KeptWhole>;System.Windows.Forms;System.Windows.Forms.Primitives;System.Private.Windows.Core;System.Private.Windows.GdiPlus;System.Drawing;System.Drawing.Common;Accessibility;</KeptWhole>
  </PropertyGroup>
  <Target Name="TrimLibrariesOnly" AfterTargets="PrepareForILLink">
    <ItemGroup>
      <_Library Include="@(ManagedAssemblyToLink)" Condition="('%(ManagedAssemblyToLink.NuGetPackageId)' == 'Microsoft.NETCore.App.Runtime.win-x64' or '%(ManagedAssemblyToLink.NuGetPackageId)' == 'Microsoft.WindowsDesktop.App.Runtime.win-x64' or '%(Filename)' == 'Microsoft.Windows.SDK.NET') and !$(KeptWhole.Contains(';%(Filename);'))" />
      <ManagedAssemblyToLink Remove="@(_Library)" />
      <ManagedAssemblyToLink>
        <IsTrimmable>false</IsTrimmable>
        <TrimMode>copy</TrimMode>
      </ManagedAssemblyToLink>
      <ManagedAssemblyToLink Include="@(_Library)">
        <IsTrimmable>true</IsTrimmable>
        <TrimMode>link</TrimMode>
      </ManagedAssemblyToLink>
    </ItemGroup>
  </Target>
  <!--
    Never used by the app: the debugger's and crash dump's own files, and the PDF library's PDF merger (qpdf; its
    default font Lato stays: it is the fallback of every text of a report).
  -->
  <Target Name="DropDebuggerFiles" AfterTargets="ComputeResolvedFilesToPublishList" Condition="'$(Configuration)' == 'Release'">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="$([System.String]::new('%(Filename)').StartsWith('mscordaccore')) or '%(Filename)' == 'mscordbi' or '%(Filename)' == 'Microsoft.DiaSymReader.Native.amd64' or '%(Filename)' == 'createdump' or '%(Filename)' == 'qpdf'" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Finance.Core\Finance.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\app.ico" LogicalName="app.ico" />
    <EmbeddedResource Include="..\..\ui\dist\**\*" LogicalName="ui/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <Target Name="CheckUi" BeforeTargets="BeforeBuild" Condition="!Exists('..\..\ui\dist\index.html')">
    <Error Text="The interface is not built. Run 'npm ci' then 'npm run build' in the ui folder, or use tools\build.ps1." />
  </Target>

</Project>
