<Project Sdk="Microsoft.NET.Sdk">

  <!-- Fictitious statements in the layouts of real banks (every person, number and amount invented), and copies of
       real statements published on the internet, as published (Statements/Real), shared by the
       unit tests, the integration tests and the SampleStatements tool. Never shipped. -->
  <PropertyGroup>
    <RootNamespace>ProductivityApp.Finance.Testing</RootNamespace>
    <AssemblyName>ProductivityApp.Finance.TestData</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Finance.Core\Finance.Core.csproj" />
  </ItemGroup>

  <!-- Copies of real statements published on the internet, with the personal details replaced (RealStatements.cs). -->
  <ItemGroup>
    <EmbeddedResource Include="Statements\Real\*.txt" LogicalName="Real.%(Filename).txt" />
  </ItemGroup>

</Project>
