<Project>
  <!-- Settings shared by every project under tests/: the targets of the engine they exercise, and nothing to publish. -->
  <PropertyGroup>
    <!-- Both targets of the engine: Windows' own and the portable one of macOS and Linux. -->
    <!-- The Windows target is built on Windows only (the SDK of macOS and Linux cannot build it). -->
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('Windows'))">net10.0-windows10.0.19041.0;net10.0</TargetFrameworks>
    <TargetFrameworks Condition="!$([MSBuild]::IsOSPlatform('Windows'))">net10.0</TargetFrameworks>
    <SupportedOSPlatformVersion Condition="$(TargetFramework.Contains('-windows'))">10.0.19041.0</SupportedOSPlatformVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- Test code and test data run optimised in every configuration: the generators and checkers of the tests (the
         diagram inspector, the invented periods) do millions of small steps. -->
    <Optimize>true</Optimize>
  </PropertyGroup>

  <!-- The xUnit test projects (unit and integration): same framework, runner and SDK versions. -->
  <PropertyGroup Condition="'$(IsTestProject)' == 'true'">
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <ItemGroup Condition="'$(IsTestProject)' == 'true'">
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit.v3" Version="4.0.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
    <Using Include="Xunit" />
    <!-- Every test runs in parallel with every other (not only one class at a time): xunit.runner.json. -->
    <Content Include="$(MSBuildThisFileDirectory)xunit.runner.json" Link="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- The garbage collector of the test runs compacts harder to keep less memory (measured: 15% less peak memory with
         tests in parallel, at the same speed). The app keeps its own settings. -->
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="7" />
  </ItemGroup>
</Project>
