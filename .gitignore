# Build output
bin/
obj/
# publish/: only the app as built for this computer (publish\ProductivityApp.exe) is kept, as the release files are.
/publish/*
!/publish/ProductivityApp.exe
TestResults/
ui/node_modules/
ui/dist/
ui/node_modules/.tmp/
*.tsbuildinfo

# Personal data never goes into the repository: databases, statements, reports, logs.
*.db
*.db-shm
*.db-wal
*.db-journal
*.sqlite
*.pdf
*.csv
*.ofx
*.qfx
*.qif
*.log
data/

# Editors and local tool folders
.vs/
.vscode/
.idea/
/.*/
*.user
*.suo
